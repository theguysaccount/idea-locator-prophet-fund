# Idea Locator settings. Every one is optional; the build, refresh and deploy run with none.
# On GitHub set these as repository *variables* (Settings > Secrets and variables > Actions > Variables).
# None of them is a secret. Copy to .env for local runs; .env is git-ignored.

IL_BASE_URL=            # canonical origin + path; default https://theguysaccount.github.io/idea-locator-prophet-fund
IL_CUSTOM_DOMAIN=       # e.g. ripeness.example.org; writes dist/CNAME (set IL_BASE_URL to https://<domain> too)
IL_GOATCOUNTER=         # https://<code>.goatcounter.com/count  cookieless page and event counts; off when empty
IL_RELOOK_REPORT_URL=   # the money slot: link for private fund re-look reports; hidden when empty
IL_REPO=                # owner/name for correction links; default theguysaccount/idea-locator-prophet-fund
IL_TODAY=               # YYYY-MM-DD override for tests
IL_OUT=                 # build output directory; default dist/
CHROME=                 # Chrome or Chromium binary for share images (scripts/og.py)
